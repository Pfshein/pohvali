.env
.env.*
!.env.example
!frontend/.env.development
# Runtime state deploy.sh writes into the project root (.deploy-current,
# .deploy-previous, .deploy-backups/, .deploy.lock). release() refuses to
# deploy while `git status --porcelain` reports anything, untracked files
# included, so any artifact left here blocks every later release. Matched by
# prefix so a new one does not have to be discovered by a failed deploy.
.deploy-*
.deploy.lock
.idea/
.vscode/
.DS_Store
Thumbs.db

frontend/node_modules/
frontend/dist/
frontend/coverage/

backend/.venv/
backend/.pytest_cache/
backend/.ruff_cache/
backend/.mypy_cache/
backend/**/__pycache__/
backend/**/*.py[cod]
backend/.coverage
backend/htmlcov/

postgres-data/
backups/

backend/*.egg-info/
