# Offsite upload settings for PH-704B (private S3-compatible object storage).
# Install as /etc/pohvali-backup/offsite.env owned by root with mode 0600.
# Contains bucket credentials: never commit real values anywhere.
POHVALA_OFFSITE_ENABLED=1
POHVALA_OFFSITE_ENDPOINT=https://fsn1.your-objectstorage.com
POHVALA_OFFSITE_REGION=fsn1
POHVALA_OFFSITE_BUCKET=pohvali-backup
POHVALA_OFFSITE_PREFIX=postgres
POHVALA_OFFSITE_RETENTION_COUNT=14
POHVALA_OFFSITE_ACCESS_KEY_ID=replace-with-access-key-id
POHVALA_OFFSITE_SECRET_ACCESS_KEY=replace-with-secret-access-key
