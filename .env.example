APP_ENV=development
APP_DOMAIN=https://example.com
VITE_TELEGRAM_MODE=mock
BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
TELEGRAM_WEBHOOK_PATH=replace-with-a-random-path
# Telegram ids allowed to use the admin /add_mascot bot command; empty disables it.
TELEGRAM_ADMIN_IDS=
POSTGRES_DB=pohvala
POSTGRES_USER=pohvala
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+asyncpg://pohvala:replace-me@postgres:5432/pohvala
CORS_ORIGINS=http://localhost,http://localhost:5173
